# Copy this file to .env and fill in values for local overrides.
# For production, set these as environment variables in your deployment platform.
# All variables marked REQUIRED must be set when running with --spring.profiles.active=prod.

# ── Database ──────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/crichere
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres          # REQUIRED in prod

# ── Redis ─────────────────────────────────────────────────────────────────────
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=                                  # REQUIRED in prod — min 256-bit hex string
JWT_EXPIRATION_MS=3600000                    # 1 hour
JWT_REFRESH_EXPIRATION_DAYS=30

# ── AWS S3 ────────────────────────────────────────────────────────────────────
S3_BUCKET=crichere-assets                    # REQUIRED in prod

# ── MSG91 SMS ─────────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=                              # REQUIRED in prod
MSG91_TEMPLATE_ID=                           # REQUIRED in prod

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000   # REQUIRED in prod — comma-separated list of allowed web origins

# ── Firebase ──────────────────────────────────────────────────────────────────
# FIREBASE_CREDENTIALS_JSON=                 # REQUIRED in prod — path to service account JSON
